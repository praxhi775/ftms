rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The admin is the account that has a document in /admins (created by you in the console)
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // One activity log entry: exactly these four fields, saved with the server time, by the person writing it
    function validEntry() {
      return request.resource.data.keys().hasOnly(['type', 'message', 'at', 'actorId'])
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 200
        && request.resource.data.at == request.time
        && request.resource.data.actorId == request.auth.uid;
    }

    function isActiveManager() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Lets the app ask "am I an admin?" for your own account only. Nobody can list or write admins.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid} {
      // a manager can read their own profile (even when blocked, to show the blocked message)
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // self-registration: only your own profile, always as an active manager
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'manager'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'role', 'status', 'createdAt', 'lastLoginAt']);

      // a manager may only update their own last-login / last-active time, and not while blocked;
      // the admin may only change status (block / unblock)
      allow update: if
        (signedIn() && request.auth.uid == uid && isActiveManager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'lastActiveAt']))
        ||
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'statusChangedAt', 'statusChangedBy'])
          && request.resource.data.status in ['active', 'blocked']);

      allow delete: if false;

      // Activity log: a manager can add entries to their own log but never edit or delete them.
      // The admin can read every log and can add only the "blocked" / "unblocked" entries.
      match /activity/{entryId} {
        allow create: if validEntry() && (
          (signedIn() && request.auth.uid == uid && isActiveManager())
          || (isAdmin() && request.resource.data.type in ['account.blocked', 'account.unblocked'])
        );
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow update, delete: if false;
      }
    }
  }
}